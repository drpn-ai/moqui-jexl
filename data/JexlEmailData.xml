<entity-facade-xml type="seed">
    <!-- The default email of the built-in email delivery (moqui.jexl.ScriptServices.deliver#ScriptEmail). An application
        points a delivery at its own template with the emailTemplateId parameter. -->
    <moqui.basic.email.EmailTemplate emailTemplateId="JEXL_SCRIPT_RESULT" description="User script result" emailServerId="SYSTEM"
            bodyScreenLocation="component://moqui-jexl/screen/JexlScriptResultEmail.xml" webappName="webroot"
            fromAddress="${org.moqui.util.SystemBinding.getPropOrEnv(&apos;jexl_email_from&apos;) ?: &apos;&apos;}" ccAddresses="" bccAddresses="" subject="${scriptName}" sendPartial="Y"/>
</entity-facade-xml>

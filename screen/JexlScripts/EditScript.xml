<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Script" default-menu-index="2" default-menu-include="false">
    <parameter name="userScriptId"/>
    <transition name="storeScript" begin-transaction="false">
        <service-call name="moqui.jexl.ScriptServices.store#UserScript" in-map="context" out-map="context"/>
        <default-response url="." parameter-map="[userScriptId:userScriptId]"/><error-response url="."/>
    </transition>
    <transition name="runScript" begin-transaction="false">
        <service-call name="moqui.jexl.ScriptServices.run#UserScript" in-map="[userScriptId:userScriptId]" out-map="runOut"/>
        <actions><script><![CDATA[
            if (runOut?.ok) {
                Map r = runOut.normalizedResult ?: [:]
                String files = (r.files ?: []).collect { it.name + ' (' + (it.rows?.size() ?: 0) + ' rows)' }.join(', ')
                ec.message.addMessage("Ran in ${runOut.elapsedMs} ms, ${runOut.units} units. ${r.summary ?: ''}${files ? ' Files: ' + files : ''}${runOut.readCounts ? ' Read: ' + runOut.readCounts : ''}".toString())
            } else if (runOut?.error) {
                ec.message.addError("${runOut.error.kind}${runOut.error.line ? ' line ' + runOut.error.line : ''}: ${runOut.error.message}".toString())
            }
        ]]></script></actions>
        <default-response url="." parameter-map="[userScriptId:userScriptId]"/>
    </transition>
    <transition name="editDeployment"><default-response url="../EditDeployment"/></transition>
    <actions>
        <entity-find-one entity-name="jexl.script.UserScript" value-field="userScript"/>
        <entity-find entity-name="jexl.script.UserScriptDeployment" list="deploymentList"><econdition field-name="userScriptId" ignore-if-empty="false"/></entity-find>
        <set field="profileList" from="org.moqui.jexl.ScriptProfiles.names()"/>
    </actions>
    <widgets>
        <form-single name="EditScriptForm" map="userScript" transition="storeScript">
            <field name="userScriptId"><default-field><hidden/></default-field></field>
            <field name="scriptName"><default-field title="Name"><text-line size="60"/></default-field></field>
            <field name="description"><default-field><text-line size="80"/></default-field></field>
            <field name="scriptProfile"><default-field title="Profile"><drop-down><list-options list="profileList"/></drop-down></default-field></field>
            <field name="readSpecJson"><default-field title="Read Spec (JSON)"><text-area rows="8" cols="100"/></default-field></field>
            <field name="scriptBody"><default-field title="Script (JEXL)"><text-area rows="16" cols="100"/></default-field></field>
            <field name="sampleInputJson"><default-field title="Sample Input (JSON)"><text-area rows="4" cols="100"/></default-field></field>
            <field name="isActive"><default-field title="Active"><drop-down><option key="Y"/><option key="N"/></drop-down></default-field></field>
            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
        </form-single>
        <section name="SavedSection" condition="userScript != null"><widgets>
            <container>
                <link url="runScript" text="Run" parameter-map="[userScriptId:userScriptId]"/>
                <link url="editDeployment" text="New Deployment" parameter-map="[userScriptId:userScriptId]"/>
            </container>
            <form-list name="DeploymentListForm" list="deploymentList" skip-form="true">
                <field name="scriptDeploymentId"><default-field title="Deployment"><link url="editDeployment" text="${cronExpression} (${timeZone ?: 'server zone'})"
                        parameter-map="[scriptDeploymentId:scriptDeploymentId]" link-type="anchor"/></default-field></field>
                <field name="isActive"><default-field title="Active"><display/></default-field></field>
                <field name="lastRunStatus"><default-field title="Last Run"><display/></default-field></field>
                <field name="lastRunDate"><default-field title="At"><display/></default-field></field>
            </form-list>
        </widgets></section>
    </widgets>
</screen>

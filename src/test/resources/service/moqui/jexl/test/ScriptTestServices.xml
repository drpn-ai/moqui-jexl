<!-- Input, delivery and busy-check services that UserScriptDeploymentTests names on its deployments. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="read" noun="Orders">
        <implements service="moqui.jexl.ScriptServices.read#UserScriptDeploymentInput"/>
        <actions>
            <set field="input" from="[orders:[[orderId:'SO-1', itemsBackordered:[[sku:'A', quantity:2]]],
                    [orderId:'SO-2', itemsBackordered:[[sku:'A', quantity:1], [sku:'B', quantity:4]]]]]"/>
            <set field="inputSummary" from="[source:'orders', deploymentId:scriptDeployment.scriptDeploymentId]"/>
        </actions>
    </service>
    <service verb="read" noun="Nothing">
        <implements service="moqui.jexl.ScriptServices.read#UserScriptDeploymentInput"/>
        <actions><set field="message" value="No finished result to read yet."/></actions>
    </service>

    <service verb="deliver" noun="ToTestEntity">
        <description>Records each delivery as a moqui.test.TestEntity row: testMedium = deployment id, testLong = the script result as JSON.</description>
        <implements service="moqui.jexl.ScriptServices.deliver#UserScriptDeploymentResult"/>
        <actions>
            <service-call name="create#moqui.test.TestEntity" in-map="[testMedium:scriptDeployment.scriptDeploymentId,
                    testLong:groovy.json.JsonOutput.toJson(scriptResult)]"/>
            <set field="message" value="Recorded."/>
        </actions>
    </service>
    <service verb="deliver" noun="RecordUser">
        <description>Records who the delivery ran as: testMedium = deployment id + '_USER', testLong = ec.user.userId.</description>
        <implements service="moqui.jexl.ScriptServices.deliver#UserScriptDeploymentResult"/>
        <actions>
            <service-call name="create#moqui.test.TestEntity" in-map="[testMedium:scriptDeployment.scriptDeploymentId + '_USER', testLong:ec.user.userId]"/>
        </actions>
    </service>
    <service verb="deliver" noun="Slow">
        <description>Sleeps delivery.parameters.sleepMs, then records like ToTestEntity (testMedium = deployment id + '_SLOW').</description>
        <implements service="moqui.jexl.ScriptServices.deliver#UserScriptDeploymentResult"/>
        <actions>
            <script>Thread.sleep((delivery?.parameters?.sleepMs ?: 0) as long)</script>
            <service-call name="create#moqui.test.TestEntity" in-map="[testMedium:scriptDeployment.scriptDeploymentId + '_SLOW']"/>
        </actions>
    </service>
    <service verb="deliver" noun="Refused">
        <implements service="moqui.jexl.ScriptServices.deliver#UserScriptDeploymentResult"/>
        <actions><return error="true" message="The endpoint refused it."/></actions>
    </service>

    <!-- an ordinary service, not marked as a delivery: a deployment may never name it -->
    <service verb="delete" noun="Everything">
        <in-parameters><parameter name="scriptResult" type="Object"/></in-parameters>
        <actions><service-call name="create#moqui.test.TestEntity" in-map="[testMedium:'USD_TEST_UNMARKED_RAN']"/></actions>
    </service>

    <!-- a script service written in JEXL: run by org.moqui.jexl.JexlScriptRunner through the .jexl script-runner -->
    <service verb="sum" noun="Lines" type="script" location="classpath://script/moqui/jexl/test/SumLines.jexl">
        <in-parameters><parameter name="lines" type="List"/></in-parameters>
        <out-parameters><parameter name="total" type="BigDecimal"/><parameter name="lineCount" type="Integer"/></out-parameters>
    </service>

    <!-- read sources for ReadStepTests -->
    <service verb="read" noun="FixedSource">
        <description>Three fixed lines (qty 1, 2, 3), filtered by the input's where; echoUser: one row naming the
            logged-in user; sleepMs: sleeps first.</description>
        <implements service="moqui.jexl.ScriptServices.read#ScriptSource"/>
        <actions><script><![CDATA[
            if (input.sleepMs) Thread.sleep(input.sleepMs as long)
            // spinMs: busy for that long, ignoring any interrupt (a read that will not stop)
            if (input.spinMs) { long until = System.currentTimeMillis() + (input.spinMs as long); while (System.currentTimeMillis() < until) { Thread.onSpinWait() } }
            if (input.echoUser) { rows = [[userId: ec.user.userId]]; rowCount = 1L; return }
            if (input.echoScope) { rows = [[userScriptId: userScriptId, ownerKey: ownerKey]]; rowCount = 1L; return }
            List all = [[line: 'L1', qty: 1], [line: 'L2', qty: 2], [line: 'L3', qty: 3]]
            rows = input.where ? all.findAll { org.moqui.jexl.script.ReadConditions.matches(input.where, it) } : all
            rowCount = (long) rows.size()
        ]]></script></actions>
    </service>

    <service verb="check" noun="QueueFull">
        <out-parameters><parameter name="busyReason"/></out-parameters>
        <actions><set field="busyReason" value="the order queue is full"/></actions>
    </service>
</services>
